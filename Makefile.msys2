BUILD := build
EFI := $(BUILD)/BOOTX64.EFI
KERNEL := $(BUILD)/KERNEL.ELF
ROOTFS_DIR := rootfs
ROOTFS := $(BUILD)/ROOTFS.TAR
USER_ELF_TEST := $(ROOTFS_DIR)/bin/elftest.elf
USER_SUPERVISOR := $(ROOTFS_DIR)/bin/supervisor.elf
USER_WORKER_SERVICE := $(ROOTFS_DIR)/bin/workerservice.elf
USER_ORDINARY_SERVICE := $(ROOTFS_DIR)/bin/ordinaryservice.elf
USER_ORDINARY_SERVICE_REPLACEMENT := $(ROOTFS_DIR)/bin/ordinaryservice-v2.elf
USER_CONSOLE_SERVICE := $(ROOTFS_DIR)/bin/consoleservice.elf
USER_HELLO := $(ROOTFS_DIR)/bin/hello.elf
USER_INPUT_ECHO := $(ROOTFS_DIR)/bin/inputecho.elf
USER_LAUNCH_PROBE := $(ROOTFS_DIR)/bin/launchprobe.elf
USER_RUNTIME_TEST := $(ROOTFS_DIR)/bin/runtimetest.elf
USER_RUNTIME_CANCEL_TEST := $(ROOTFS_DIR)/bin/runtimecanceltest.elf
USER_RUNTIME_BLOCK_TEST := $(ROOTFS_DIR)/bin/runtimeblocktest.elf
USER_DISPLAY_SERVICE := $(ROOTFS_DIR)/bin/displayservice.elf
USER_COMPOSITOR_SERVICE := $(ROOTFS_DIR)/bin/compositorservice.elf
USER_SURFACE_APP := $(ROOTFS_DIR)/bin/surfaceapp.elf
USER_MEDIA_PLAYER := $(ROOTFS_DIR)/bin/mediaplayer.elf
.DEFAULT_GOAL := all
.DELETE_ON_ERROR:

USER_PROGRAMS := $(USER_ELF_TEST) $(USER_SUPERVISOR) $(USER_WORKER_SERVICE) $(USER_ORDINARY_SERVICE) $(USER_ORDINARY_SERVICE_REPLACEMENT) $(USER_CONSOLE_SERVICE) $(USER_HELLO) $(USER_INPUT_ECHO) $(USER_LAUNCH_PROBE) $(USER_RUNTIME_TEST) $(USER_RUNTIME_BLOCK_TEST) $(USER_RUNTIME_CANCEL_TEST) $(USER_DISPLAY_SERVICE) $(USER_COMPOSITOR_SERVICE) $(USER_SURFACE_APP) $(USER_MEDIA_PLAYER)
ROOTFS_FILES := $(shell test -d $(ROOTFS_DIR) && find $(ROOTFS_DIR) -type f)
IMAGE := $(BUILD)/JA-os.img

CLANG ?= clang
LLD_LINK ?= lld-link
LD := ld.lld
NASM ?= nasm
PYTHON ?= python
FFMPEG ?= ffmpeg
READELF ?= llvm-readelf
OBJDUMP ?= llvm-objdump
QEMU ?= qemu-system-x86_64
FRAMEBUFFER_WIDTH ?= 0
FRAMEBUFFER_HEIGHT ?= 0
OVMF_CODE ?= /mingw64/share/qemu/edk2-x86_64-code.fd
OVMF_VARS ?= /mingw64/share/qemu/edk2-i386-vars.fd

# A successful inspection is required; tool failure is not a clean ELF report.
define CHECK_ELF_RELOCATIONS
	@set -eu; \
	if ! relocations="$$(LC_ALL=C $(READELF) -r "$@")"; then \
		echo "Failed to inspect ELF relocations: $@" >&2; \
		exit 1; \
	fi; \
	case "$$relocations" in \
		*R_X86_64*) \
			printf '%s\n' "$$relocations"; \
			echo "Runtime relocations are unsupported: $@" >&2; \
			exit 1 ;; \
		'') \
			echo "No ELF relocations: $@" ;; \
	esac
endef

$(BUILD)/user_elftest.o: user/elftest.S include/user_abi.h | $(BUILD)
	$(CLANG) --target=x86_64-unknown-none-elf -c $< -o $@

$(USER_ELF_TEST): $(BUILD)/user_elftest.o user/elftest.ld Makefile.msys2
	mkdir -p $(dir $@)
	$(LD) -m elf_x86_64 -nostdlib -static \
	      -T user/elftest.ld \
	      -o $@ $(BUILD)/user_elftest.o
	$(CHECK_ELF_RELOCATIONS)

$(BUILD)/user_crt0.o: user/crt0.S | $(BUILD)
	$(CLANG) --target=x86_64-unknown-none-elf -c $< -o $@

$(BUILD)/user_crt0_startup.o: user/crt0_startup.S include/program_startup.h include/user_abi.h | $(BUILD)
	$(CLANG) --target=x86_64-unknown-none-elf -c $< -o $@

$(BUILD)/user_syscall.o: user/lib/syscall.S include/user_abi.h | $(BUILD)
	$(CLANG) --target=x86_64-unknown-none-elf -c $< -o $@

$(BUILD)/user_supervisor.o: user/supervisor.c \
                            user/lib/syscall.h \
                            include/user_abi.h \
                            include/program_startup.h \
                            include/supervisor_protocol.h | $(BUILD)
	$(CLANG) $(USER_CFLAGS) -c $< -o $@

$(USER_SUPERVISOR): $(BUILD)/user_crt0_startup.o \
                    $(BUILD)/user_syscall.o \
                    $(BUILD)/user_supervisor.o \
                    user/supervisor.ld Makefile.msys2
	mkdir -p $(dir $@)
	$(LD) -m elf_x86_64 -nostdlib -static \
	      -T user/supervisor.ld \
	      -o $@ \
	      $(BUILD)/user_crt0_startup.o \
	      $(BUILD)/user_syscall.o \
	      $(BUILD)/user_supervisor.o
	$(CHECK_ELF_RELOCATIONS)

