MEDIA_DIR := $(wildcard media)
ifeq ($(MEDIA_DIR),)
MEDIA_STREAMS :=
else
MEDIA_STREAMS := $(ROOTFS_DIR)/media/badapple.jmv $(ROOTFS_DIR)/media/caramel.jmv

$(MEDIA_STREAMS) &: tools/encode_media.py | $(BUILD)
	@command -v "$(FFMPEG)" >/dev/null || { echo "Missing FFmpeg ($(FFMPEG)). Install it or set FFMPEG=/path/to/ffmpeg.exe" >&2; exit 1; }
	mkdir -p $(ROOTFS_DIR)/media
	$(PYTHON) tools/encode_media.py --ffmpeg "$(FFMPEG)" --input-dir media --output-dir $(ROOTFS_DIR)/media
endif

$(ROOTFS): $(USER_PROGRAMS) $(MEDIA_STREAMS) $(ROOTFS_FILES) | $(BUILD)
	@test -d "$(ROOTFS_DIR)" || { echo "Missing $(ROOTFS_DIR) directory"; exit 1; }
	@files="$$(find "$(ROOTFS_DIR)" -type f -print -quit)" || exit 1; \
		test -n "$$files" || { echo "$(ROOTFS_DIR) contains no files"; exit 1; }
	rm -f $@
	tar --format=ustar -cf $@ -C $(ROOTFS_DIR) .

LOADER_CFLAGS := --target=x86_64-pc-win32-coff -std=c11 -ffreestanding \
                 -fno-stack-protector -fno-builtin -fno-exceptions \
                 -fno-asynchronous-unwind-tables -fno-unwind-tables \
                 -Wall -Wextra -Werror -O2 \
                 -DJCOS_FRAMEBUFFER_WIDTH=$(FRAMEBUFFER_WIDTH) \
                 -DJCOS_FRAMEBUFFER_HEIGHT=$(FRAMEBUFFER_HEIGHT)

KERNEL_CFLAGS := --target=x86_64-unknown-none-elf -std=c11 -ffreestanding \
                 -fno-stack-protector -fno-builtin -fpie -fno-plt \
                 -fvisibility=hidden -mno-red-zone -mgeneral-regs-only -mno-sse -mno-sse2 \
                 -fno-asynchronous-unwind-tables -fno-unwind-tables \
                 -Wall -Wextra -Werror -O2

USER_CFLAGS := --target=x86_64-unknown-none-elf -std=c11 -ffreestanding \
               -fno-stack-protector -fno-builtin -fpie -fno-plt \
               -fvisibility=hidden -mno-red-zone -mgeneral-regs-only -mno-sse -mno-sse2 \
               -fno-asynchronous-unwind-tables -fno-unwind-tables \
               -Wall -Wextra -Werror -O2

KERNEL_CPPFLAGS := -Ikernel -Ikernel/shell -Ikernel/tests -Iinclude
KERNEL_C_SOURCES := $(sort $(shell find kernel -type f -name '*.c'))
KERNEL_C_OBJECTS := $(patsubst %.c,$(BUILD)/%.o,$(KERNEL_C_SOURCES))
KERNEL_HEADERS := $(sort $(shell find kernel include -type f -name '*.h'))
NASM_PATH := $(shell command -v $(NASM) 2>/dev/null)

.PHONY: all binaries image media validate run run-headless inspect clean check-build-tools check-image-tools check-inspect-tools check-run-tools

all: check-image-tools $(IMAGE)
binaries: check-build-tools $(EFI) $(KERNEL)
image: check-image-tools $(IMAGE)
media: $(MEDIA_STREAMS)
check-build-tools:
	@command -v $(CLANG) >/dev/null || { echo "Missing $(CLANG). Run: pacman -S --needed mingw-w64-x86_64-clang"; exit 1; }
	@command -v $(LLD_LINK) >/dev/null || { echo "Missing $(LLD_LINK). Run: pacman -S --needed mingw-w64-x86_64-lld"; exit 1; }
	@command -v $(LD) >/dev/null || { echo "Missing $(LD). Run: pacman -S --needed mingw-w64-x86_64-lld"; exit 1; }
	@command -v $(READELF) >/dev/null || { echo "Missing $(READELF). Run: pacman -S --needed mingw-w64-x86_64-llvm-tools"; exit 1; }

check-image-tools: check-build-tools
	@command -v $(PYTHON) >/dev/null || { echo "Missing $(PYTHON). Run: pacman -S --needed mingw-w64-x86_64-python"; exit 1; }

check-inspect-tools: check-build-tools
	@command -v $(OBJDUMP) >/dev/null || { echo "Missing $(OBJDUMP). Run: pacman -S --needed mingw-w64-x86_64-llvm-tools"; exit 1; }

check-run-tools: check-image-tools
	@command -v $(QEMU) >/dev/null || { echo "Missing $(QEMU). Run: pacman -S --needed mingw-w64-x86_64-qemu"; exit 1; }

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/loader.obj: loader/loader.c loader/uefi.h loader/elf.h include/boot_info.h | $(BUILD)
	$(CLANG) $(LOADER_CFLAGS) -c loader/loader.c -o $@

$(EFI): $(BUILD)/loader.obj
	MSYS2_ARG_CONV_EXCL='*' $(LLD_LINK) /subsystem:efi_application /entry:efi_main /nodefaultlib /machine:x64 \
	           /dynamicbase /nxcompat /out:$@ $^

ifneq ($(NASM_PATH),)
$(BUILD)/arch.o: kernel/arch.asm include/boot_info.h | $(BUILD)
	@echo "Using NASM: $(NASM_PATH)"
	$(NASM) -f elf64 kernel/arch.asm -o $@
else
$(BUILD)/arch.o: kernel/arch.S include/boot_info.h | $(BUILD)
	@echo "NASM not found; using equivalent Clang/GAS fallback kernel/arch.S"
	$(CLANG) --target=x86_64-unknown-none-elf -c -x assembler kernel/arch.S -o $@
endif

$(BUILD)/%.o: %.c $(KERNEL_HEADERS) | $(BUILD)
	mkdir -p $(dir $@)
	$(CLANG) $(KERNEL_CFLAGS) $(KERNEL_CPPFLAGS) -c $< -o $@

$(KERNEL): $(BUILD)/arch.o $(KERNEL_C_OBJECTS) kernel/linker.ld Makefile.msys2
	$(LD) -m elf_x86_64 -pie -Bsymbolic --no-dynamic-linker --no-undefined -nostdlib \
	      -T kernel/linker.ld -o $@ $(BUILD)/arch.o $(KERNEL_C_OBJECTS)
	$(CHECK_ELF_RELOCATIONS)

$(IMAGE): $(EFI) $(KERNEL) $(ROOTFS) tools/make_usb_image.py
	$(PYTHON) tools/make_usb_image.py $(EFI) $(KERNEL) $(ROOTFS) $(IMAGE)

validate: check-image-tools $(IMAGE) tools/validate_image.py
	$(PYTHON) tools/validate_image.py $(IMAGE) $(EFI) $(KERNEL) $(ROOTFS)

inspect: check-inspect-tools binaries
	@echo "=== EFI loader ==="
	$(OBJDUMP) -p $(EFI) | grep -E 'file format|Subsystem|reloc' || true
	@echo "=== kernel ELF ==="
	$(READELF) -h $(KERNEL) | grep -E 'Class:|Type:|Machine:|Entry point'
	$(READELF) -l $(KERNEL)
	$(READELF) -r $(KERNEL)
	@echo "=== important symbols ==="
	$(READELF) -s $(KERNEL) | grep -E '(_start|kernel_main|interrupt_dispatch|isr_stub_offsets)' || true

run: check-run-tools $(IMAGE) tools/run_qemu.sh
	OVMF_CODE="$(OVMF_CODE)" OVMF_VARS="$(OVMF_VARS)" tools/run_qemu.sh $(IMAGE)

run-headless: check-run-tools $(IMAGE) tools/run_qemu.sh
	OVMF_CODE="$(OVMF_CODE)" OVMF_VARS="$(OVMF_VARS)" tools/run_qemu.sh --headless $(IMAGE)

clean:
	rm -rf $(BUILD)
	rm -f $(USER_PROGRAMS)
