BUILD := build
EFI := $(BUILD)/BOOTX64.EFI
KERNEL := $(BUILD)/KERNEL.ELF
IMAGE := $(BUILD)/hello-os-v5.img

CLANG := clang
LLD_LINK := lld-link
LD := ld.lld
NASM := nasm

LOADER_CFLAGS := --target=x86_64-pc-win32-coff -std=c11 -ffreestanding \
                 -fno-stack-protector -fno-builtin -fno-exceptions \
                 -fno-asynchronous-unwind-tables -fno-unwind-tables \
                 -Wall -Wextra -Werror -O2

KERNEL_CFLAGS := --target=x86_64-unknown-none-elf -std=c11 -ffreestanding \
                 -fno-stack-protector -fno-builtin -fpie -fno-plt \
                 -fvisibility=hidden -mno-red-zone -mno-sse -mno-sse2 \
                 -fno-asynchronous-unwind-tables -fno-unwind-tables \
                 -Wall -Wextra -Werror -O2

KERNEL_C_SOURCES := $(sort $(wildcard kernel/*.c))
KERNEL_C_OBJECTS := $(patsubst kernel/%.c,$(BUILD)/kernel_%.o,$(KERNEL_C_SOURCES))
KERNEL_HEADERS := $(wildcard kernel/*.h) include/boot_info.h
NASM_PATH := $(shell command -v $(NASM) 2>/dev/null)

.PHONY: all binaries image validate run run-headless inspect clean

all: $(IMAGE)
binaries: $(EFI) $(KERNEL)
image: $(IMAGE)

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/loader.obj: loader/loader.c loader/uefi.h loader/elf.h include/boot_info.h | $(BUILD)
	$(CLANG) $(LOADER_CFLAGS) -c loader/loader.c -o $@

$(EFI): $(BUILD)/loader.obj
	$(LLD_LINK) /subsystem:efi_application /entry:efi_main /nodefaultlib /machine:x64 \
	           /dynamicbase /nxcompat /out:$@ $^

ifneq ($(NASM_PATH),)
$(BUILD)/arch.o: kernel/arch.asm include/boot_info.h | $(BUILD)
	@echo "Using NASM: $(NASM_PATH)"
	$(NASM) -f elf64 kernel/arch.asm -o $@
else
$(BUILD)/arch.o: kernel/arch.S include/boot_info.h | $(BUILD)
	@echo "NASM not found; using equivalent Clang/GAS fallback kernel/arch.S"
	$(CLANG) --target=x86_64-unknown-none-elf -c -x assembler kernel/arch.S -o $@
endif

$(BUILD)/kernel_%.o: kernel/%.c $(KERNEL_HEADERS) | $(BUILD)
	$(CLANG) $(KERNEL_CFLAGS) -c $< -o $@

$(KERNEL): $(BUILD)/arch.o $(KERNEL_C_OBJECTS) kernel/linker.ld
	$(LD) -pie -Bsymbolic --no-dynamic-linker --no-undefined -nostdlib \
	      -T kernel/linker.ld -o $@ $(BUILD)/arch.o $(KERNEL_C_OBJECTS)
	@relocs=$$(readelf -r $@ | grep -c 'R_X86_64' || true); \
	if [ "$$relocs" != "0" ]; then \
		echo "Kernel has runtime relocations; this loader does not apply them."; \
		readelf -r $@; exit 1; \
	fi

$(IMAGE): $(EFI) $(KERNEL) tools/make_usb_image.py
	python3 tools/make_usb_image.py $(EFI) $(KERNEL) $(IMAGE)

validate: $(IMAGE)
	python3 tools/validate_image.py $(IMAGE) $(EFI) $(KERNEL)

inspect: binaries
	@echo "=== EFI loader ==="
	llvm-objdump -p $(EFI) | grep -E 'file format|Subsystem|reloc' || true
	@echo "=== kernel ELF ==="
	readelf -h $(KERNEL) | grep -E 'Class:|Type:|Machine:|Entry point'
	readelf -l $(KERNEL)
	readelf -r $(KERNEL)
	@echo "=== important symbols ==="
	readelf -s $(KERNEL) | grep -E '(_start|kernel_main|interrupt_dispatch|isr_stub_offsets)' || true

run: $(IMAGE) tools/run_qemu.sh
	tools/run_qemu.sh $(IMAGE)

run-headless: $(IMAGE) tools/run_qemu.sh
	tools/run_qemu.sh --headless $(IMAGE)

clean:
	rm -rf $(BUILD)
